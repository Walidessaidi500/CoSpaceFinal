# =============================================
# CoSpace Backend - Variables de Entorno
# =============================================
# Copiar este archivo como .env y rellenar los valores.
# En Railway, configurar estas variables en: Settings > Variables

# --- Aplicación ---
APP_NAME=CoSpace
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-backend.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Base de Datos (MySQL en Railway) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Alternativa: Railway provee DATABASE_URL (MySQL URL completa)
# DB_URL=

# --- Sesiones ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none

# --- Cache y Colas ---
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- CORS (URLs del frontend en Railway) ---
FRONTEND_URL=https://tu-frontend.up.railway.app

# --- Sanctum ---
SANCTUM_STATEFUL_DOMAINS=tu-frontend.up.railway.app,localhost:4200,127.0.0.1:4200

# --- Correo (Brevo) ---
BREVO_API_KEY=
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cospace.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Stripe ---
STRIPE_KEY=
STRIPE_SECRET=

# --- Otros ---
VITE_APP_NAME="${APP_NAME}"
